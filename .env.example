# Required for live searches. The test suite runs without it.
SERPAPI_API_KEY=

# Required only for the intent router (q.find without engine=).
# Pin an engine instead and SearchMux needs no LLM at all.
ANTHROPIC_API_KEY=

# Optional additional providers. Each falls back to the env var named
# below; SearchMux never touches a key for a provider you don't use.
TAVILY_API_KEY=
BRAVE_API_KEY=
EXA_API_KEY=
